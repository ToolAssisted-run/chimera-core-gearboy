{
  "coreName": "Gearboy",
  "systemNames": {
    "GB": "Game Boy",
    "GBC": "Game Boy Color",
    "SGB": "Super Game Boy"
  },
  "author": "Ignacio Sanchez (drhelius) and the Gearboy contributors; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-gearboy",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64",
    "windows-aarch64",
    "linux-aarch64",
    "macos-aarch64"
  ],
  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    4,
    16,
    64
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. This is room, not use: memory is taken as the machine touches it. The largest cartridge is 8 MB and Gearboy keeps one copy of it, rounded up to a power of two; a Game Boy Color has 32 KB of work memory and 16 KB of video memory, a cartridge at most 1 MB more (an MBC6's flash memory).",
  "video": {
    "_comment": "The buffer's capacity: the Super Game Boy's picture, 256x224, its border around the Game Boy's screen. A Game Boy or Game Boy Color picture is 160x144; the live size comes from GetVideoWidth/Height. The frame rate is the console's own: 4,194,304 cycles a second, 70,224 a frame, 59.73 frames a second.",
    "width": 256,
    "height": 224,
    "vsyncNumerator": 4194304,
    "vsyncDenominator": 70224,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "Gearboy's sound chip gives 44,100 stereo samples a second, about 738 a frame; a frame with the screen off is up to a quarter longer.",
    "rate": 44100,
    "samplesPerFrame": 2048,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "machineSetting": "model",
  "settings": [
    {
      "name": "model",
      "display": "setting.model",
      "type": "enum",
      "options": [
        "GB",
        "GBC",
        "GBA",
        "SGB"
      ],
      "default": "GB",
      "description": "setting.model.about"
    },
    {
      "name": "bootRom",
      "display": "setting.bootrom",
      "type": "enum",
      "options": [
        "off",
        "on"
      ],
      "default": "off",
      "when": [
        "GB",
        "GBC"
      ],
      "description": "setting.bootrom.about"
    },
    {
      "name": "sgbCartridge",
      "display": "setting.sgbcartridge",
      "type": "enum",
      "options": [
        "none",
        "SGB1",
        "SGB2"
      ],
      "default": "none",
      "when": [
        "SGB"
      ],
      "description": "setting.sgbcartridge.about"
    },
    {
      "name": "palette",
      "display": "setting.palette",
      "type": "enum",
      "options": [
        "green",
        "grey"
      ],
      "default": "green",
      "description": "setting.palette.about"
    },
    {
      "name": "colorCorrection",
      "display": "setting.colorcorrection",
      "type": "enum",
      "options": [
        "off",
        "on"
      ],
      "default": "off",
      "when": [
        "GBC",
        "GBA"
      ],
      "description": "setting.colorcorrection.about"
    }
  ],
  "_firmware_note": "The boot ROM of the Game Boy or the Game Boy Color, needed when Boot ROM is 'on', and the Super Game Boy's own cartridge, needed when the Super Game Boy cartridge setting names one. The ids are the names they are commonly given. Gearboy knows three dumps of the Super Game Boy's cartridge and one of the Super Game Boy 2's, by their CRC-32; it refuses any other.",
  "firmware": [
    {
      "id": "dmg_boot.bin",
      "display": "firmware.dmg_boot_bin",
      "description": "firmware.dmg_boot_bin.about",
      "size": 256,
      "sha1": "4ED31EC6B0B175BB109C0EB5FD3D193DA823339F",
      "name": "dmg_boot.bin",
      "requiredWhen": {
        "all": [
          {
            "setting": "bootRom",
            "is": "on"
          },
          {
            "setting": "model",
            "is": "GB"
          }
        ]
      }
    },
    {
      "id": "cgb_boot.bin",
      "display": "firmware.cgb_boot_bin",
      "description": "firmware.cgb_boot_bin.about",
      "size": 2304,
      "sha1": "1293D68BF9643BC4F36954C1E80E38F39864528D",
      "name": "cgb_boot.bin",
      "requiredWhen": {
        "all": [
          {
            "setting": "bootRom",
            "is": "on"
          },
          {
            "setting": "model",
            "is": "GBC"
          }
        ]
      }
    },
    {
      "id": "SGB1.sfc",
      "display": "firmware.sgb1_sfc",
      "description": "firmware.sgb1_sfc.about",
      "size": 262144,
      "name": "SGB1.sfc",
      "nameHints": [
        "sgb",
        "super game boy"
      ],
      "requiredWhen": {
        "all": [
          {
            "setting": "model",
            "is": "SGB"
          },
          {
            "setting": "sgbCartridge",
            "is": "SGB1"
          }
        ]
      }
    },
    {
      "id": "SGB2.sfc",
      "display": "firmware.sgb2_sfc",
      "description": "firmware.sgb2_sfc.about",
      "size": 524288,
      "name": "SGB2.sfc",
      "nameHints": [
        "sgb",
        "super game boy"
      ],
      "requiredWhen": {
        "all": [
          {
            "setting": "model",
            "is": "SGB"
          },
          {
            "setting": "sgbCartridge",
            "is": "SGB2"
          }
        ]
      }
    }
  ],
